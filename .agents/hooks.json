{
  "gdscript-lint-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|.*script_create.*|.*script_patch.*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../tools/hooks/post_gdlint.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "protect-critical-files": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ../tools/hooks/pre_safety_check.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
