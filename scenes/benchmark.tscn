theme_override_font_sizes/font_size = 16
text = "MODE 1: Naive SceneTree 노드 (기준선)"
horizontal_alignment = 2

[node name="StatusLabel" type="Label" parent="UI/TopRightPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "활성 개체: 0 | 개별 셰이더: ON"
horizontal_alignment = 2

[node name="BackButton" type="Button" parent="UI/TopRightPanel/MarginContainer/VBoxContainer"]
