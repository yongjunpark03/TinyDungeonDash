[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/benchmark.gd" id="1_benchmark"]
[ext_resource type="PackedScene" path="res://scenes/dungeon_map.tscn" id="2_dungeon"]

[node name="BenchmarkArena" type="Node2D"]
script = ExtResource("1_benchmark")

[node name="DungeonMap" parent="." instance=ExtResource("2_dungeon")]

[node name="EntityLayer" type="Node2D" parent="."]

[node name="UI" type="CanvasLayer" parent="."]

[node name="TopRightPanel" type="PanelContainer" parent="UI"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -480.0
offset_top = 14.0
offset_right = -14.0
offset_bottom = 138.0
grow_horizontal = 0

[node name="MarginContainer" type="MarginContainer" parent="UI/TopRightPanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBoxContainer" type="VBoxContainer" parent="UI/TopRightPanel/MarginContainer"]
layout_mode = 2
